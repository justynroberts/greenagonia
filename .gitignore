# build output (binary lands at parent repo root: ../greenagonia)

# site files copied here at build time (source of truth: site/)
cli/site/

# single-user terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/terraform.tfstate.d/
terraform/terraform.tfvars
terraform/crash.log
terraform/*.plan

# shared terraform — state and secrets, never commit
terraform-shared/.terraform/
terraform-shared/.terraform.lock.hcl
terraform-shared/terraform.tfstate
terraform-shared/terraform.tfstate.*
terraform-shared/terraform.tfstate.d/
terraform-shared/crash.log
terraform-shared/*.plan
terraform-shared/*.tfvars
terraform-shared/*.auto.tfvars.json
terraform-shared/slack-secrets.json

# local env
.env
*.local
.DS_Store
